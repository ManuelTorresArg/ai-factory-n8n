# Copiá a .env y ajustá.  cp .env.example .env

# Repo git sobre el que trabaja la fábrica (ruta absoluta en tu PC). Debe tener la rama main.
TARGET_REPO=/home/manu/proyectos/mi-proyecto

# Token compartido n8n ↔ runner (generalo con: openssl rand -hex 24)
FACTORY_TOKEN=cambiame

# Tu UID/GID para que los archivos creados en el repo queden a tu nombre (id -u / id -g)
UID=1000
GID=1000

# OmniRoute en el host escucha sólo en 127.0.0.1:20128. omniroute-bridge (socat) lo expone en la IP de docker0.
# Si cambiaste el bip de Docker, ajustá DOCKER_HOST_IP (ip -4 addr show docker0).
OMNIROUTE_PORT=20128
OMNIROUTE_BRIDGE_PORT=20129
DOCKER_HOST_IP=172.17.0.1
OMNIROUTE_BASE_URL=http://host.docker.internal:20129/v1
OMNIROUTE_API_KEY=sk-local

# Combos de OmniRoute por rol (ver factory.yaml > roles)
COMBO_ARCHITECT=hermes-coder-high   # spec, aprobador, gate
COMBO_BUILDER=hermes-coder-mid      # tool calling en el loop del Builder
COMBO_REVIEWER=hermes-qa            # revisores y librarian
COMBO_VISION=auto/best-vision       # revisor UI con capturas

# 1 = LLM simulado, para probar el circuito sin gastar tokens
FACTORY_MOCK=0

# Toolchains extra dentro del runner (los tests de tu repo corren ahí)
WITH_NODE=false
WITH_PLAYWRIGHT=false
